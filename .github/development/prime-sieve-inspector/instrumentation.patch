+    }
+
+    SEXP InspectionReport(SEXP primes, const CacheInspection::Inspector& inspector,
+                          SEXP requestedBytes) {
+        using namespace cpp11;
+        using CacheInspection::KernelRecord;
+        std::vector<const KernelRecord*> records;
+        std::vector<int> workerIds;
+        int phaseRows = 0;
+        for (std::size_t worker = 0; worker < inspector.workers.size(); ++worker) {
+            for (const auto& record : inspector.workers[worker]) {
+                records.push_back(&record);
+                workerIds.push_back(worker + 1);
+                for (auto calls : record.calls) if (calls) ++phaseRows;
+            }
+        }
+
+        writable::integers worker(records.size());
+        writable::strings kernel(records.size());
+        writable::doubles lower(records.size()), upper(records.size());
+        for (std::size_t i = 0; i < records.size(); ++i) {
+            worker[i] = workerIds[i];
+            kernel[i] = records[i]->kernel;
+            lower[i] = records[i]->lower;
+            upper[i] = records[i]->upper;
+        }
+        const std::size_t KernelRecord::* fields[] = {
+            &KernelRecord::segmentSpan, &KernelRecord::sieveBytes,
+            &KernelRecord::offsetBytes, &KernelRecord::bucketEntries,
+            &KernelRecord::bucketCapacityBytes, &KernelRecord::bufferBytes,
+            &KernelRecord::primeCount, &KernelRecord::outputCapacityBytes,
+            &KernelRecord::segments
+        };
+        writable::list kernels(13);
+        kernels.names() = writable::strings({
+            "worker", "kernel", "lower", "upper", "segment_span", "sieve_bytes",
+            "offset_bytes", "bucket_entries", "bucket_capacity_bytes",
+            "buffer_bytes", "prime_count", "output_capacity_bytes", "segments"
+        });
+        kernels[0] = worker; kernels[1] = kernel;
+        kernels[2] = lower; kernels[3] = upper;
+        for (std::size_t j = 0; j < 9; ++j) {
+            writable::doubles column(records.size());
+            for (std::size_t i = 0; i < records.size(); ++i) {
+                column[i] = records[i]->*fields[j];
+            }
+            kernels[j + 4] = column;
+        }
+
+        writable::integers phaseWorker(phaseRows);
+        writable::strings phaseKernel(phaseRows), phase(phaseRows);
+        writable::doubles seconds(phaseRows), calls(phaseRows);
+        int row = 0;
+        for (std::size_t i = 0; i < records.size(); ++i) {
+            for (std::size_t p = 0; p < CacheInspection::PhaseCount; ++p) {
+                if (!records[i]->calls[p]) continue;
+                phaseWorker[row] = workerIds[i];
+                phaseKernel[row] = records[i]->kernel;
+                phase[row] = CacheInspection::PhaseNames[p];
+                seconds[row] = records[i]->seconds[p];
+                calls[row] = records[i]->calls[p];
+                ++row;
+            }
+        }
+        writable::list phases({"worker"_nm = phaseWorker, "kernel"_nm = phaseKernel,
+                              "phase"_nm = phase, "seconds"_nm = seconds,
+                              "calls"_nm = calls});
+        writable::list summary({
+            "requested_threads"_nm = inspector.requestedThreads,
+            "effective_threads"_nm = inspector.effectiveThreads,
+            "requested_segment_bytes"_nm = requestedBytes,
+            "effective_segment_span"_nm = static_cast<double>(inspector.bigSegmentSpan),
+            "base_seconds"_nm = inspector.baseSeconds,
+            "policy_seconds"_nm = inspector.policySeconds,
+            "sieve_seconds"_nm = inspector.sieveSeconds,
+            "result_seconds"_nm = inspector.resultSeconds
+        });
+        writable::list shared({
+            "base_prime_bytes"_nm = static_cast<double>(inspector.sharedPrimeBytes),
+            "dense_prime_bytes"_nm = static_cast<double>(inspector.densePrimeBytes),
+            "bucket_prime_bytes"_nm = static_cast<double>(inspector.bucketPrimeBytes),
+            "wheel_bytes"_nm = static_cast<double>(inspector.wheelBytes)
+        });
+        return writable::list({"primes"_nm = primes, "summary"_nm = summary,
+            "phases"_nm = DataFrame(phases, phaseRows),
+            "kernels"_nm = DataFrame(kernels, records.size()), "shared"_nm = shared});
+    }
+}
