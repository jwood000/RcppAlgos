+[[cpp11::register]]
+SEXP PrimeSieveInspectCpp(SEXP Rb1, SEXP Rb2, SEXP RNumThreads,
+                          SEXP RmaxCores, SEXP RmaxThreads, SEXP RsegmentBytes) {
+    CacheInspection::Inspector inspector;
+    if (!Rf_isNull(RsegmentBytes)) {
+        if ((TYPEOF(RsegmentBytes) != REALSXP && TYPEOF(RsegmentBytes) != INTSXP) ||
+            Rf_xlength(RsegmentBytes) != 1) {
+            cpp11::stop("segmentBytes must be a single finite whole number of bytes");
+        }
+        const double bytes = Rf_asReal(RsegmentBytes);
+        // Leave room for a final marking increment in Big's int offsets.
+        const double maxBytes = std::numeric_limits<int>::max() / 16;
+        if (!std::isfinite(bytes) || bytes != std::floor(bytes) ||
+            bytes < std::ceil(NUM30030 / 8.0) || bytes > maxBytes) {
+            cpp11::stop("segmentBytes must be a whole number between 3754 and %g", maxBytes);
+        }
+        inspector.bigSegmentSpan = static_cast<std::size_t>(bytes * 8 / NUM30030) * NUM30030;
+    }
+    cpp11::sexp primes = PrimeSieveImpl(Rb1, Rb2, RNumThreads,
+                                       RmaxCores, RmaxThreads, &inspector);
+    return InspectionReport(primes, inspector, RsegmentBytes);
+}
